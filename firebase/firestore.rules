rules_version = '2';

// Void Home shared households. Used by the iOS app and the Android app unchanged.
// See AI_CONTEXT.md "Shared households" for the data layout these rules protect.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function houseData(houseId) {
      return get(/databases/$(database)/documents/houses/$(houseId)).data;
    }

    function isMember(houseId) {
      return signedIn() && request.auth.uid in houseData(houseId).memberIds;
    }

    // users/{uid}: profile and current house. Only the account itself.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // invites/{code}: code -> houseId. Anyone signed in may look up one code (get, not list).
    // Only the house owner may create or remove codes for their house.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/houses/$(request.resource.data.houseId)).data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/houses/$(request.resource.data.houseId)).data.inviteCode == code;
      allow update: if false;
      allow delete: if signedIn() && (
        !exists(/databases/$(database)/documents/houses/$(resource.data.houseId))
        || houseData(resource.data.houseId).ownerId == request.auth.uid
      );
    }

    match /houses/{houseId} {
      allow get: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow list: if false;

      // Create: the creator is the owner and the only member.
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.inviteCode is string;

      allow update: if signedIn() && (
        // Owner: anything, but the owner must stay (or become) a member.
        (resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId in request.resource.data.memberIds)

        // Member: edit house name/address, edit own member entry, or leave.
        || (request.auth.uid in resource.data.memberIds
          && resource.data.ownerId != request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'address', 'updatedAt', 'memberIds', 'members'])
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
          && (request.resource.data.memberIds == resource.data.memberIds
              || (request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().difference([request.auth.uid].toSet())
                  && !(request.auth.uid in request.resource.data.members))))

        // Join: not a member yet, adds only themselves, and proves the current invite code.
        || (!(request.auth.uid in resource.data.memberIds)
          && resource.data.inviteCode != ''
          && request.resource.data.joinCode == resource.data.inviteCode
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['memberIds', 'members', 'joinCode', 'updatedAt'])
          && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().union([request.auth.uid].toSet())
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid]))
      );

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      // Shared ("Everyone") records: any member reads and writes. updatedBy must be the writer.
      match /items/{itemId} {
        allow read: if isMember(houseId);
        allow create, update: if isMember(houseId)
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.syncId == itemId
          && request.resource.data.type is string;
        allow delete: if isMember(houseId);
      }

      // "Just me" records: only their creator, while a member. Not even the owner can read them.
      match /private/{uid}/items/{itemId} {
        allow read, write: if isMember(houseId) && request.auth.uid == uid;
      }
    }
  }
}
